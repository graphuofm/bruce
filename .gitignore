# Rust
# NOT /target/ — bruce-cdc and bruce-pg are standalone crates with
# their own workspaces, so a root-anchored rule misses their build
# artifacts (9,546 files at last count).
target/
**/*.rs.bk
Cargo.lock.orig

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
dist/

# maturin build artifacts
/target/wheels/

# editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# local experiment outputs
*.log
